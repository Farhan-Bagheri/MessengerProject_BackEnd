{
  "AllowedHosts": "*",

  "ForwardedHeaders": {
    "ForwardLimit": 1,

    "KnownProxies": [
      "127.0.0.1",
      "::1"
    ],

    "KnownNetworks": []
  },

  "Jwt": {
    "Issuer": "IdentityApi",
    "Audience": "ShopClient",
    "Key": "YourSuperSecrerertyher4tgdgetegbfghg45tergdfgdtrex45436ergtdyret43rdget43tgdfgert4etg4tKey",
    "ExpiryMinutes": 60
  },

  "Services": {
    "Identity": {
      "BaseUrl": "http://farhanshop-identity.runasp.net",
      "Prefix": "/identity",
      "DisplayName": "Identity API"
    },
    "Shop": {
      "BaseUrl": "http://farhanshop-shop.runasp.net",
      "Prefix": "/shop",
      "DisplayName": "Shop API"
    }
  },

  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/identity/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/identity"
          }
        ]
      },

      "shop-route": {
        "ClusterId": "shop-cluster",
        "Match": {
          "Path": "/shop/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/shop"
          }
        ]
      }
    },

    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity-api": {
            "Address": "http://farhanshop-identity.runasp.net/"
          }
        }
      },

      "shop-cluster": {
        "Destinations": {
          "shop-api": {
            "Address": "http://localhost:7002"
          }
        }
      }
    }
  }
}