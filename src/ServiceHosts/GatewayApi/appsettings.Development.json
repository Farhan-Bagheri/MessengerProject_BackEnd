{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Jwt": {
    "Issuer": "Shop",
    "Audience": "ShopClient",
    "Key": "YourSuperSecrerertyher4tgdgetegbfghg45tergdfgdtrex45436ergtdyret43rdget43tgdfgert4etg4tKey",
    "ExpiryMinutes": 60
  },

  "ReverseProxy": {
    "Routes": {
      // =======
      // IdentityApi
      // =======
      "identity-openapi": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/openapi/identity/v1.json"
        },
        "Transforms": [
          {
            "PathSet": "/openapi/v1.json"
          }
        ]
      },
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/identity/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/shop"
          }
        ]
      },

      // =======
      // ShopApi
      // =======
      "shop-openapi": {
        "ClusterId": "shop-cluster",
        "Match": {
          "Path": "/openapi/shop/v1.json"
        },
        "Transforms": [
          {
            "PathSet": "/openapi/v1.json"
          }
        ]
      },
      "shop-route": {
        "ClusterId": "shop-cluster",
        "Match": {
          "Path": "/shop/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/shop"
          }
        ]
      }
    },

    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity-api": {
            "Address": "http://localhost:7001"
          }
        }
      },
      "shop-cluster": {
        "Destinations": {
          "shop-api": {
            "Address": "http://localhost:7002"
          }
        }
      }
    }
  }
}
